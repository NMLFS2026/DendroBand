## PULL DIAMETERS AT BANDING
## READ FILES IN
diapath <- ("S:/Ecology/Student_folders_&_files/Maura 2026/Dendro Exploration/BA_calculations_by_tree_copy.xlsx")
#get sheet names and apply them to separate sub tables
separate_sheet_names2 <- excel_sheets(diapath)
all_sheets2 <- lapply(separate_sheet_names2, function(sheet) {
read_excel(diapath, sheet = sheet)
})
names(all_sheets2) <- separate_sheet_names2
#loop through names and set them as separate dataframes with _df suffix
for (i in names(all_sheets2)) {
assign(paste0(i, "_df"), as.data.frame(all_sheets2[[i]]))
}
## Trying to get all of the intial DBH measurements in one place
# Combine into one dataframe
combined <- imap_dfr(all_sheets2, ~ {
if ('diameter (cm) at banding' %in% names(.x)) {
tibble(
ID = .y,
dbh_banding_cm = .x[['diameter (cm) at banding']][1]
)}
else { NULL }
})
#write_xlsx(combined, "S:/Ecology/Student_folders_&_files/Maura 2026/Dendro Exploration/initial_dbh.xlsx")
## 06/12/26 -- Compiling into a compatible document
#manually updated the tree ID names from A-03-1 to A1-03 for consistency
#could not find initial dbh for B26, B27 or B28
dbh_cm <- read_xlsx("S:/Ecology/Student_folders_&_files/Maura 2026/Dendro Exploration/initial_dbh.xlsx")
dbh_cm <- dbh_cm %>%
mutate(rad_banding_cm = dbh_banding_cm/2)
################################################################################
## CONVERT CHANGES INTO BA GROWTH MEASUREMENTS
# ------------------------------------------------------------------------------
# cross checking if every tree id is there
site_A_tree_IDs <- unique(site_A4$ID)
site_B_tree_IDs <- unique(site_B4$ID)
site_C_tree_IDs <- unique(site_C4$ID)
# ------------------------------------------------------------------------------
#remove the rows with no change recorded
site_A5 <- subset(site_A4, !is.na(change_in_circum_mm))
#calc the difference between the raw values (mm) and convert to (cm)
site_A6 <- site_A5 %>%
arrange(ID, date) %>%
group_by(ID) %>%
filter(!(date == lag(date) & change_in_circum_mm == lag(change_in_circum_mm) & adjust =='adj')) %>% # this removes duplicates that aren't adjusted, just labeled as adj
mutate(
diff_cm = case_when(
band_type == 'vernier' ~ ((change_in_circum_mm - lag(change_in_circum_mm, default = change_in_circum_mm[1]))) *.1,
band_type == 'tube'    ~ ((change_in_circum_mm - lag(change_in_circum_mm, default = change_in_circum_mm[1]))) * -.1
)) %>%
mutate(diff_cm = replace(diff_cm, 1, 0), # first diff is 0
diff_cm = ifelse(band_type != lag(band_type, default = band_type[1]), 0, diff_cm),  # if band type changes diff is 0
diff_cm = case_when(adjust == 'adj' ~ 0,
TRUE ~ diff_cm), # if there's an adjustment diff is 0
diff_cm = tidyr::replace_na(diff_cm, 0)) %>% #replace NA's with 0
ungroup()
View(site_A6)
site_A7 <- site_A6 %>%
arrange(ID, date) %>%
group_by(ID) %>%
mutate(cumulative_diff_cm = cumsum(diff_cm),
cumulative_diff_cm  = round(cumulative_diff_cm , 2)) %>% #2 decimal places
ungroup() # this step is included so that the data can be compared to the excel sheets
site_A8 <- site_A7 %>%
arrange(ID, date) %>%
group_by(ID) %>%
mutate(radial_growth_cm =  diff_cm - lag(diff_cm, default = diff_cm[1]),
radial_growth_cm = diff_cm/(2*pi), #<--------------------this feels odd to me
radial_growth2_cm = round(radial_growth_cm, 4)) %>% # rounded to 4 decimal places
ungroup()
View(site_A8)
#add to the initial banding radius (cm) to get tree size
site_A9 <- site_A8 %>% #<----------------- there's a problem here, the cumulative rad growth is slightly off over time
arrange(ID, date) %>%
group_by(ID) %>%
mutate(cumulative_rad_growth_cm = if_else(row_number() == 1,
radial_growth_cm + dbh_cm$rad_banding_cm[match(ID, dbh_cm$ID)],
radial_growth_cm)) %>%
mutate(cumulative_rad_growth_cm = accumulate(radial_growth_cm, ~ .x +.y, .init = first(cumulative_rad_growth_cm))[-1]) %>%
mutate(cumulative_rad_growth_cm2 = if_else(row_number() == 1,  ## this version is calc with the 4 decimals in radial_growth2_cm
radial_growth2_cm + dbh_cm$rad_banding_cm[match(ID, dbh_cm$ID)],
radial_growth2_cm)) %>%
mutate(cumulative_rad_growth_cm2 = accumulate(radial_growth2_cm, ~ .x +.y, .init = first(cumulative_rad_growth_cm2))[-1],
