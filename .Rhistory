axis.title.y = element_text(size = 12))
ggplot(dead_A, aes(date, cumulative_BAI, color = ID)) +
geom_line(size = 1) +
theme_minimal() +
labs(
title = "Dead Trees: BAI in Bandelier NM over time",
x = "Time",
y = "BAI",
color = "Tree")+
theme(plot.title = element_text(hjust = 0.5),
axis.title.x = element_text(size = 12),
axis.title.y = element_text(size = 12))
## LIBRARY
#install.packages("readxl")
#install.packages("tidyverse")
#install.packages("writexl")
library(writexl)
library(tidyverse)
library(readxl)
library(tidyr)
library(dplyr)
library(purrr)
## SETTING DIRECTORY
# where all the files used here are located
setwd("S:/Ecology/Student_folders_&_files/Maura 2026/Dendro Exploration")
getwd()
###############################################################################
## READ FILES IN
rawpath <- ("S:/Ecology/Student_folders_&_files/Maura 2026/Dendro Exploration/RawData_1991_2026_Dendroband.xlsx")
#get sheet names and apply them to separate sub tables
separate_sheet_names <- excel_sheets(rawpath)
all_sheets <- lapply(separate_sheet_names, function(sheet) {
read_excel(rawpath, sheet = sheet)
})
names(all_sheets) <- separate_sheet_names
#separate the sheets into independent objects
site_A_tube    <- as.data.frame(all_sheets[["siteA_tube bands"]])
site_A_vernier <- as.data.frame(all_sheets[["siteA_vernier bands"]])
site_B_tube    <- as.data.frame(all_sheets[["siteB_tube bands"]])
site_B_vernier <- as.data.frame(all_sheets[["siteB_vernier bands"]])
site_B_add     <- as.data.frame(all_sheets[["Site B additional trees"]])
site_C_tube    <- as.data.frame(all_sheets[["siteC_tube bands"]])
site_C_vernier <- as.data.frame(all_sheets[["siteC_vernier bands"]])
###############################################################################
## CLEAN DATA
# rename notes/date & remove any rows that have NA in the date column
sA_tube_c     <- site_A_tube%>% rename(Notes = note) %>% drop_na(date)
sA_vernier_c  <- site_A_vernier %>% rename(Notes = Note) %>% drop_na(date)
sB_tube_c     <- site_B_tube %>% drop_na(date)
sB_vernier_c  <- site_B_vernier %>% drop_na(date)
sB_add_c      <- site_B_add %>% rename(date = date_text) %>% drop_na(date)
sC_tube_c     <- site_C_tube %>% rename(Notes = note) %>% drop_na(date)
sC_vernier_c  <- site_C_vernier %>% rename(Notes = note) %>% drop_na(date)
# remove A2-03? - this step was confirmated by conversation with Kay
sA_vernier_c <- sA_vernier_c %>% select(-"A2-03?")
## -----------------------------------------------------------------------------
## Pull the soil data out and make tree only data frames
A_tube_soil    <-  sA_tube_c %>% select(date, soil_temp_F,adjust, Notes)
A_vernier_soil <-  sA_vernier_c %>% select(date, soil_temp_F, adjust, Notes)
B_tube_soil    <-  sB_tube_c %>% select(date, soil_temp_F,adjust, Notes)
B_vernier_soil <-  sB_vernier_c %>% select(date, soil_temp_F,adjust, Notes)
C_tube_soil    <-  sC_tube_c %>% select(date, soil_temp_F, adjust, Notes)
C_vernier_soil <-  sC_vernier_c %>% select(date, soil_temp_F,adjust, Notes)
## -----------------------------------------------------------------------------
# create tree only frames
A_tube_tree     <-  sA_tube_c %>% select(-soil_temp_F, -Notes)
A_vernier_tree  <-  sA_vernier_c %>% select(-soil_temp_F,, -Notes)
B_tube_tree     <-  sB_tube_c %>% select(-soil_temp_F, -Notes)
B_vernier_treeA <-  sB_vernier_c %>% select(-soil_temp_F, -Notes)
C_tube_tree     <-  sC_tube_c %>% select(-soil_temp_F,  -Notes)
C_vernier_tree  <-  sC_vernier_c %>% select(-soil_temp_F,  -Notes)
# left join the additional trees dataframe to the B vernier data frame by date
B_vernier_tree <- left_join(B_vernier_treeA, sB_add_c)
# reorganize the frames so that each date and tree are their own row and
# adding the band_type and site
#a
A_tube_tree_long <- A_tube_tree %>%
pivot_longer(
cols = -c(date, adjust), #does not reshape the date column
names_to = 'ID',
values_to = 'change_in_circum_mm'
) %>%
mutate(site = 'A') %>%
mutate(band_type = 'tube')
A_vernier_tree_long <- A_vernier_tree %>%
pivot_longer(
cols = -c(date, adjust),
names_to = 'ID',
values_to = 'change_in_circum_mm'
) %>%
mutate(site = 'A') %>%
mutate(band_type = 'vernier')
#b
B_tube_tree_long <- B_tube_tree %>%
pivot_longer(
cols = -c(date, adjust),
names_to = 'ID',
values_to = 'change_in_circum_mm'
) %>%
mutate(site = 'B') %>%
mutate(band_type = 'tube')
B_vernier_tree_long <- B_vernier_tree %>%
pivot_longer(
cols = -c(date, adjust),
names_to = 'ID',
values_to = 'change_in_circum_mm'
) %>%
mutate(site = 'B') %>%
mutate(band_type = 'vernier')
#c
C_tube_tree_long <- C_tube_tree %>%
pivot_longer(
cols = -c(date, adjust),
names_to = 'ID',
values_to = 'change_in_circum_mm'
) %>%
mutate(site = 'C') %>%
mutate(band_type = 'tube')
C_vernier_tree_long <- C_vernier_tree %>%
pivot_longer(
cols = -c(date, adjust),
names_to = 'ID',
values_to = 'change_in_circum_mm'
) %>%
mutate(site = 'C') %>%
mutate(band_type = 'vernier')
